# Local development configuration. Copy to .env only when you need to override
# these non-secret defaults; Docker Compose reads .env automatically.
POSTGRES_DB=app_starter
POSTGRES_USER=app_starter
# Optional backend connection password. Local disposable Compose uses trust,
# so leave this empty locally. Never use trust in shared/staging/production.
POSTGRES_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432
BACKEND_URL=http://backend:8000
